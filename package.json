{
    "name": "proces-studio",
    "productName": "ProcesStudio",
    "private": true,
    "version": "3.1.0",
    "description": "BPMN 2.0 (ISO 19510) and ISO 9001:2015 Quality Process Studio (Web)",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:local": "node scripts/dev-local.mjs",
        "build": "npm run build:ci && node scripts/generate-user-stories.cjs",
        "build:ci": "tsc && tsc -p tsconfig.server.json && vite build && node scripts/check-bundle.cjs",
        "check:bundle": "node scripts/check-bundle.cjs",
        "test": "vitest run",
        "preview": "vite preview"
    },
    "dependencies": {
        "@neondatabase/serverless": "^1.2.0",
        "@xyflow/react": "^12.4.4",
        "clsx": "^2.1.1",
        "jose": "^6.2.15",
        "jspdf": "^4.2.1",
        "lucide-react": "^0.475.0",
        "mammoth": "^1.13.0",
        "pdfjs-dist": "^6.4.299",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tailwind-merge": "^3.0.1",
        "zustand": "^5.0.3"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.5.15",
        "@types/node": "^22.20.5",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.5.2",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.7.3",
        "vite": "^6.1.0",
        "vitest": "^5.1.0",
        "xlsx": "^0.18.5"
    }
}
