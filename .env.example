# Plantilla de Configuración - ProcesStudio 3.0
# Copiá este archivo a .env y completá tus valores. NUNCA subas .env a git.
#
# REGLA: toda variable VITE_* se incrusta en el JavaScript publicado y la ve cualquiera.
# Los secretos van SIN prefijo VITE_ y solo los lee el backend (/api).

# --- Backend (variables de servidor en Vercel) ---------------------------------
# Conexión con el rol de aplicación processtudio_app (nunca con neondb_owner; el backend lo rechaza).
# Se usa APP_DATABASE_URL porque la integración Vercel-Neon ya ocupa DATABASE_URL con el rol dueño.
APP_DATABASE_URL=postgresql://processtudio_app:CAMBIAR@ep-ejemplo.us-east-1.aws.neon.tech/neondb?sslmode=require

# Clave para firmar las sesiones: 32+ caracteres aleatorios.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Client ID de Google OAuth (el mismo que usa el navegador; es público).
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Correo que se crea/asegura como Administrador al ingresar con Google.
BOOTSTRAP_ADMIN_EMAIL=

# Orígenes adicionales permitidos (separados por coma), p. ej. un dominio propio.
# El dominio desde el que se sirve la app ya está permitido.
ALLOWED_ORIGIN=

# Clave de Gemini de la organización (opcional). Se usa solo desde el servidor.
GEMINI_API_KEY=

# Clave para cifrar los secretos 2FA (TOTP) en la base: 32+ caracteres aleatorios (opcional pero recomendado).
# Una vez usada no se puede cambiar ni borrar sin que los administradores vuelvan a enrolar su 2FA.
TOTP_ENCRYPTION_KEY=

# --- Solo para scripts locales de esquema (nunca en Vercel) ---------------------
# NEON_OWNER_DATABASE_URL=postgresql://neondb_owner:...@.../neondb?sslmode=require

# --- Cliente (público) ----------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
