# Plantilla de Configuración - ProcesStudio
# Copiá este archivo a .env y completá tus credenciales. NUNCA subas .env a git.
#
# ATENCIÓN: toda variable VITE_* se incrusta en el JavaScript que se publica.
# No uses la contraseña del rol dueño (neondb_owner) en un sitio público.

# Neon PostgreSQL (solo desarrollo local / scripts de esquema)
VITE_NEON_DATABASE_URL=postgresql://usuario:password@ep-ejemplo.us-east-1.aws.neon.tech/neondb?sslmode=require

# Google Gemini API Key
VITE_GEMINI_API_KEY=AIzaSy...

# Google OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
